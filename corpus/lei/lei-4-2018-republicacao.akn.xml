    <!-- ============================================================
         ANEXO — Republicacao do DL n.o 163/2006 (versao consolidada)
         Convencao legistica PT: eIds com prefixo `rep__` para evitar
         colisao com os artigos da Lei alteradora (art_1..art_4).
         O anexo replica a estrutura body do diploma republicado.
         ============================================================ -->
    <attachments>
      <attachment eId="anx_1">
        <heading>ANEXO</heading>
        <subheading>Republicacao do Decreto-Lei n.o 163/2006, de 8 de agosto</subheading>
        <mainBody>
          <article eId="rep__art_1">
            <num>Artigo 1.o</num>
            <heading>Objeto</heading>
            <paragraph eId="rep__art_1__para_1"><content><p>O presente decreto-lei aprova o regime da acessibilidade aos edificios e estabelecimentos.</p></content></paragraph>
          </article>
          <article eId="rep__art_2">
            <num>Artigo 2.o</num>
            <heading>Ambito de aplicacao</heading>
            <paragraph eId="rep__art_2__para_1"><content><p>Aplica-se a edificios publicos e privados de acesso publico.</p></content></paragraph>
          </article>
          <article eId="rep__art_3">
            <num>Artigo 3.o</num>
            <heading>Definicoes</heading>
            <!-- redacao introduzida pela Lei n.o 4/2018, art. 2.o -->
            <paragraph eId="rep__art_3__para_1"><content><p>Para efeitos do presente diploma, aplicam-se as definicoes constantes do anexo ao Decreto-Lei n.o 163/2006.</p></content></paragraph>
          </article>
        </mainBody>
      </attachment>
